# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API).
#
# Only the PUBLISHABLE / ANON key belongs here. These variables are inlined
# into the browser bundle, so NEVER put the service-role key in them. That key
# is not needed by this app at all.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Current name for the client-safe key, e.g. sb_publishable_xxxxx
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Older projects still expose the classic anon key. The app accepts either,
# preferring the publishable key above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=